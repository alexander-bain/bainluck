+def _component_events(phase, market_id_by_outcome, event_id_by_outcome):
+    """Every event connected to ``phase``'s markets, over the whole known map."""
+    events_by_market, markets_by_event = {}, {}
+    for oid, event in event_id_by_outcome.items():
+        market = market_id_by_outcome.get(oid)
+        if event is None or market is None:
+            continue
+        events_by_market.setdefault(market, set()).add(event)
+        markets_by_event.setdefault(event, set()).add(market)
+    seen_markets, seen_events = set(), set()
+    stack = [market_id_by_outcome.get(oid) for oid in phase]
+    while stack:
+        market = stack.pop()
+        if market is None or market in seen_markets:
+            continue
+        seen_markets.add(market)
+        for event in events_by_market.get(market, ()):
+            if event not in seen_events:
+                seen_events.add(event)
+                stack.extend(markets_by_event[event])
+    return seen_events
+
+
+def live_first_phases(
+    batch, market_id_by_outcome, event_id_by_outcome, pending_events=(),
+    live_event_ids=frozenset(),
+):
+    """#10678 — the #10655 phases, live games first. Re-orders, never re-cuts.
+
+    A game component touching any event in ``live_event_ids`` (the flush's
+    snapshot of the #9418 admission re-read, `Event.status == 'live'`) goes
+    ahead of other game components; the unrelated phase stays last; order is
+    stable within each tier. Every #10655 rule — whole markets, connected
+    events, the unknown-membership and pending-refresh fallbacks — holds by
+    construction. An empty snapshot is the #10655 plan exactly.
+    """
+    phases = linked_first_phases(
+        batch, market_id_by_outcome, event_id_by_outcome,
+        pending_events=pending_events,
+    )
+    live = frozenset(live_event_ids)
+    if len(phases) < 2 or not live:
+        return phases
 
+    def tier(phase):
+        events = _component_events(
+            phase, market_id_by_outcome, event_id_by_outcome)
+        return 2 if not events else 0 if events & live else 1
 
+    return sorted(phases, key=tier)
+
+
