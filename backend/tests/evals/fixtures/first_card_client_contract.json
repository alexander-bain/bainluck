      "render": {"verdict": "real_card", "kind": "card", "stable_id": "card-a", "mounted": true},
      "semantics": {"ranking_unchanged": true, "probability_unchanged": true, "eligibility_unchanged": true, "freshness_unchanged": true},
      "expected_refusals": []
