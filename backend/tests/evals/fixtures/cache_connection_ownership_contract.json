    {"id":"cancelled-operation-leak","clients":[{"process":"web","surface":"short op","pool_id":"op","max_connections":1,"instances":1,"lifetime":"operation","owner":"request","construction":"bounded","close_paths":["normal"],"hard_loss":"provider_reap","retry_same_budget":true,"retry_creates_pool":false,"sync_on_event_loop":false}],"incident":{"cancelled":true,"released_or_invalidated":false},"expected_errors":["CANCELLATION_LEAKS_CONNECTION","POOL_CLOSE_PATH_INCOMPLETE"]},
