{
  "schema_version": "google-access-token-audience/v1",
  "audited_commit": "e1eb40c2",
  "configuration_authority": {
    "source": "server configuration allowlist, populated from Bain Luck OAuth client IDs; never trust a request-supplied client ID",
    "symbolic_allowed_client_ids": ["web_client", "ios_client"]
  },
  "verification_contract": "Introspect the OAuth access token server-side using Google's token introspection contract, normalize its client audience field, compare it to the configured allowlist, then fetch userinfo. ID-token verification is a separate flow. Reject before Firebase lookup/create, database lookup/create, custom-token mint, or session mint.",
  "response_shape_note": "Google access-token introspection commonly names the client binding audience; the implementation must normalize the exact field returned by its selected supported Google endpoint/library and fail closed when absent. Userinfo is not an audience authority.",
  "forbidden_rejection_side_effects": ["firebase_lookup_or_create","database_lookup_or_create","custom_token_minted","session_minted"],
