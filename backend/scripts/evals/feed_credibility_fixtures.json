  "implementation_contract": {
    "freshness": "Only authoritative lifecycle/date/event evidence settles a card. Probability alone never does.",
    "empty": "A live prediction card requires at least one rendered outcome with a probability.",
    "display": "Headline, contextual leader copy, list label, and bar use one declared probability authority; equal rounded labels have equal bar widths."
  },
