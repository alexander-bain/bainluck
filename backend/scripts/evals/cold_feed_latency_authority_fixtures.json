    "browser": {"metric": "first_card_ms", "target": "baseline-required-before-hard-gate"},
    "native": {"metric": "discover_feed_first_render.first_render_ms", "target": "split cache/network and app_build before hard gate"},
    "required_dimensions": ["cache_status", "singleflight", "limit", "offset", "authenticated", "app_build", "golf_provenance", "degraded_reason"]
  },
  "implementation_packets": [
