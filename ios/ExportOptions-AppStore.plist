<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App Store export options for `tools/native-upload.sh` (native, build 8 path).

  Tracked on purpose: every value here is a decision, and a plist that lives only
  in one laptop's /tmp is the same lost work as an untracked runner script.
  It holds NO credential — the App Store Connect key is read from the
  environment at run time and never written anywhere tracked.

  manageAppVersionAndBuildNumber is NO deliberately. Left at its YES default,
  Xcode silently renumbers the build during export, so the number in the archive
  we graded is not the number TestFlight receives — the one fact an unattended
  path most needs to be able to state.

  signingStyle is manual with explicit Store distribution profiles for all five
  bundles in this target: com.bainluck.Bain-Luck (named by regenerated UUID
  2a0b16b6-015f-43d7-9627-9494c8d050e1, carrying associated-appclip-app-identifiers,
  so it cannot collide with any other "BainLuck App AppStore 39" file on disk),
  com.bainluck.Bain-Luck.BainLuckWidget, com.bainluck.Bain-Luck.Clip,
  com.bainluck.Bain-Luck.watchkitapp, and
  com.bainluck.Bain-Luck.watchkitapp.SavedGlance.
-->
<plist version="1.0">
<dict>
	<key>destination</key>
	<string>export</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>method</key>
	<string>app-store-connect</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.bainluck.Bain-Luck</key>
		<string>2a0b16b6-015f-43d7-9627-9494c8d050e1</string>
		<key>com.bainluck.Bain-Luck.BainLuckWidget</key>
		<string>BainLuck Widget AppStore 39</string>
		<key>com.bainluck.Bain-Luck.Clip</key>
		<string>BainLuck Clip AppStore</string>
		<key>com.bainluck.Bain-Luck.watchkitapp</key>
		<string>BainLuck Watch AppStore 38</string>
		<key>com.bainluck.Bain-Luck.watchkitapp.SavedGlance</key>
		<string>BainLuck Watch SavedGlance AppStore 38</string>
	</dict>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>teamID</key>
	<string>J893F72P4R</string>
	<key>testFlightInternalTestingOnly</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
