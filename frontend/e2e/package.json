{
  "name": "bainluck-e2e-browser-audit",
  "private": true,
  "version": "1.0.0",
  "description": "L2-221 \u2014 the browser-audit rail (replaces the retired third-party browser QA provider). Locked, portable Playwright. Kept OUT of the main frontend dependency tree so it never touches Vercel/CI installs or `next build`.",
  "scripts": {
    "contract": "node --test contract/*.test.js",
    "smoke": "playwright test --project=desktop --project=mobile discover-smoke",
    "latency": "playwright test --project=desktop --project=mobile discover-latency",
    "sports-latency": "playwright test --project=desktop --project=mobile sports-latency",
    "tournament-inventory": "playwright test --project=desktop --project=mobile tournament-inventory",
    "consent": "playwright test --project=desktop --project=mobile consent",
    "grid": "playwright test --project=desktop --project=mobile championship-grid",
    "calibration": "playwright test --project=desktop --project=mobile calibration",
    "cohort-copy": "playwright test --project=desktop --project=mobile cohort-copy --reporter=list --fully-parallel --workers=8",
    "daily-challenge": "playwright test --project=desktop --project=mobile daily-challenge",
    "render-states": "node scripts/l2238-render-states.js",
    "smoke-consent": "playwright test --project=desktop --project=mobile discover-smoke consent",
    "validate": "node scripts/validate-manifest.js",
    "wait-for-sha": "node scripts/wait-for-frontend-sha.js",
    "blend-parity": "playwright test --project=desktop --project=mobile blend-surface-parity"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2"
  }
}
