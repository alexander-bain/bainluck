# Production API URL (set in Vercel dashboard)
NEXT_PUBLIC_API_URL=https://api.bainluck.com

# Sentry error tracking (set in Vercel dashboard)
NEXT_PUBLIC_SENTRY_DSN=

# GA4 measurement id (public, build-time-inlined — not a secret).
# Analytics is DISABLED when this is unset (no hardcoded fallback property).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: enables source map uploads for better stack traces
# SENTRY_AUTH_TOKEN=
